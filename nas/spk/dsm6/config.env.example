# PS5 PKG Sender native Synology package configuration.
# Copy is created automatically at /var/packages/PKGSenderNAS/var/config.env.
# The package starts with these defaults. Use the Web UI to set your PS5 IP
# and real PKG library paths after installation.

PKGSENDER_PACKAGE_DIR="/var/packages/PKGSenderNAS/var/packages"
# Optional. JSON array for multiple library roots. When present, it takes precedence over PKGSENDER_PACKAGE_DIR.
# PKGSENDER_PACKAGE_DIRS='["/volume1/PS5/PKG","/volume1/PS5/MorePKG"]'
PKGSENDER_LISTEN=":9898"
# Optional. Leave empty to generate package URLs from the Web UI request host.
PKGSENDER_PUBLIC_BASE_URL=""
# Configure this from the Web UI before installing to PS5.
PKGSENDER_PS5_IP=""
PKGSENDER_PS5_PORT="12800"
# Optional. Native SPK sets this automatically to /var/packages/PKGSenderNAS/var/aliases.json.
# PKGSENDER_TITLE_ALIASES_FILE="/var/packages/PKGSenderNAS/var/aliases.json"

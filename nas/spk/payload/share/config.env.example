# PS5 PKG Sender native Synology package configuration.
# Copy is created automatically at /var/packages/PKGSenderNAS/var/config.env.
# Replace CHANGE_ME_* values before starting the package.

PKGSENDER_PACKAGE_DIR="/volume1/PS5/PKG"
PKGSENDER_LISTEN=":9898"
PKGSENDER_PUBLIC_BASE_URL="http://CHANGE_ME_NAS_IP:9898"
PKGSENDER_PS5_IP="CHANGE_ME_PS5_IP"
PKGSENDER_PS5_PORT="12800"
